{
  "name": "n8n-nodes-clientify",
  "version": "0.2.19",
  "description": "N8N node for Clientify CRM integration",
  "keywords": [
    "n8n-node",
    "n8n-community-node-package",
    "clientify",
    "crm"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ClientifySL/clientify_n8n#readme",
  "author": {
    "name": "Clientify",
    "email": "develop@clientify.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ClientifySL/clientify_n8n.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "node scripts/generateOperationCatalog.cjs && n8n-node build && node -e \"const fs=require('fs');fs.copyFileSync('TRIGGERS_REFERENCE.md','dist/TRIGGERS_REFERENCE.md');fs.copyFileSync('nodes/ClientifyApi/ClientifyApi.node.json','dist/nodes/ClientifyApi/ClientifyApi.node.json');fs.copyFileSync('nodes/ClientifyTrigger/ClientifyTrigger.node.json','dist/nodes/ClientifyTrigger/ClientifyTrigger.node.json');\"",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "format": "prettier \"nodes/**/*.ts\" \"credentials/**/*.ts\" \"scripts/**/*.cjs\" package.json --write",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "prepublishOnly": "npm run build && npm run lint",
    "release": "n8n-node release"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ClientifyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ClientifyApi/ClientifyApi.node.js",
      "dist/nodes/ClientifyTrigger/ClientifyTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@n8n/node-cli": "0.23.0",
    "@types/node": "^20.0.0",
    "eslint": "9.39.1",
    "n8n-workflow": "^2.2.1",
    "prettier": "^2.8.0",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
